# SITE_ADDRESS: a domain (basel-live.example.ch) gets HTTPS from Let's Encrypt automatically;
# the default :80 serves plain HTTP, for local use or behind another proxy.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /vehicles.json /stops.json /config.json
	handle @api {
		reverse_proxy app:8765
	}

	handle {
		root * /srv
		file_server
	}

	@vendor path /vendor/*
	header @vendor Cache-Control "public, max-age=31536000, immutable"
	@app not path /vendor/* /vehicles.json /stops.json /config.json
	header @app Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
